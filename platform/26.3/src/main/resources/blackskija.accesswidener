accessWidener v2 official

# GpuDevice wraps the real backend (VulkanDevice / GlDevice) in a private final
# field; VulkanSkijaBackend needs it to build the Skija DirectContext. Widening the
# field replaces fragile dev-only reflection and works under intermediary mappings.
accessible	field	com/mojang/renderpearl/frontend/FrontendGpuDevice	backend	Lcom/mojang/renderpearl/backend/api/GpuDeviceBackend;

# GlDevice (the GL GpuDeviceBackend impl) is package-private; SkijaBackend.active needs
# it to detect GL vs Vulkan at runtime. (VulkanDevice is already public.)
accessible	class	com/mojang/renderpearl/backend/opengl/GlDevice

# Minecraft skips glUseProgram while lastProgram matches, so after Skija's program it must forget it.
accessible	class	com/mojang/renderpearl/backend/opengl/GlCommandEncoder
accessible	field	com/mojang/renderpearl/backend/opengl/GlCommandEncoder	lastProgram	Lcom/mojang/renderpearl/backend/opengl/GlProgram;

# renderpearl sends a new texture's first layout transition only with the frame's own submit, after Skia's;
# VulkanSkijaBackend.acquire hands that pending init command buffer to the queue ahead of Skia's work.
accessible	field	com/mojang/renderpearl/backend/vulkan/VulkanCommandEncoder	currentInitCommandBuffer	Lorg/lwjgl/vulkan/VkCommandBuffer;
